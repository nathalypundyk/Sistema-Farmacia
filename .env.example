# Database Configuration
DB_NAME=farmaciadb
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Application Configuration
APP_PORT=8080
SERVER_PORT=8080

# Logging Configuration
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_APP=INFO
SHOW_SQL=false

# Database Connection (derived from above, but can be overridden)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/farmaciadb

# WhatsApp Configuration (CAMBIAR ANTES DE PRODUCCIÓN)
# El gateway WhatsApp corre como el servicio "whatsapp" del mismo docker-compose.yml
# (carpeta whatsapp-gateway/), por eso el valor por defecto usa el nombre del servicio.
# Si en algún momento el gateway corre fuera de Docker en la misma PC, cambiar a:
#   http://host.docker.internal:3000
WHATSAPP_API_URL=http://whatsapp:3000
# Número de la encargada del depósito, con código de país, SIN el +
WHATSAPP_ENCARGADA_NUMERO=595985771528


# Cámara de frío (script Python + Arduino simulado)
# Debe coincidir con API_KEY en dispositivo-camara-frio/config.py
CAMARAFRIO_API_KEY=hgs-camara-frio-demo
CAMARAFRIO_TEMP_MIN=18
CAMARAFRIO_TEMP_MAX=22
